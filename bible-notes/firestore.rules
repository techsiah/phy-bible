rules_version = '2';

/* Christmas 2026 · Jesus Youth · Pazhassi Raja College
   Deploy with:  firebase deploy --only firestore:rules

   Model
   -----
   readers/{roll}            owner-only. Organizer edits `uid` here to recover
                             or transfer a student's entry.
   readers/{roll}/days/{d}   owner-only reading history (one doc per day).
   readers/{roll}/notes/{n}  owner-only notes.
   board/{roll}              public projection used by the leaderboard.
   groups/{code}             public read, max four members, members only edit.

   The public board deliberately has no UID, notes, or reading history.
*/
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function readerDoc(roll) {
      return /databases/$(database)/documents/readers/$(roll);
    }

    function isOwner(roll) {
      return signedIn() && get(readerDoc(roll)).data.uid == request.auth.uid;
    }

    function validDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && day >= '2026-12-01'
        && day <= '2026-12-25';
    }

    /* Every member UID must point at a reader whose roll is the matching entry.
       The group has at most four members, so this costs at most four reads. */
    function alignedMembers(data) {
      return data.members is list
        && data.memberRolls is list
        && data.members.size() == data.memberRolls.size()
        && data.members.size() >= 1
        && data.members.size() <= 4
        && (data.members.size() < 1 || get(readerDoc(data.memberRolls[0])).data.uid == data.members[0])
        && (data.members.size() < 2 || get(readerDoc(data.memberRolls[1])).data.uid == data.members[1])
        && (data.members.size() < 3 || get(readerDoc(data.memberRolls[2])).data.uid == data.members[2])
        && (data.members.size() < 4 || get(readerDoc(data.memberRolls[3])).data.uid == data.members[3]);
    }

    /* ── Private reader entry ───────────────────────────────── */

    match /readers/{roll} {
      // A missing document is readable so a first claim can test the roll.
      // An existing entry is readable only by its owner.
      allow read: if !exists(readerDoc(roll))
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.roll is string
        && request.resource.data.roll == roll
        && request.resource.data.roll.size() >= 1
        && request.resource.data.roll.size() <= 24
        && (!request.resource.data.keys().hasAny(['phone'])
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 16))
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.roll == roll;

      allow delete: if false;

      match /days/{day} {
        allow read: if isOwner(roll);
        allow create, update: if isOwner(roll)
          && validDay(day)
          && request.resource.data.day == day
          && request.resource.data.planRead is bool
          && request.resource.data.extraReads is int
          && request.resource.data.extraReads >= 0
          && request.resource.data.extraReads <= 3
          && request.resource.data.refs is list
          && request.resource.data.refs.size() <= 4
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= 25
          && request.resource.data.updatedAt is number;
        allow delete: if false;
      }

      match /notes/{noteId} {
        allow read: if isOwner(roll);
        allow create, update: if isOwner(roll)
          && request.resource.data.id == noteId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000
          && request.resource.data.ref is string
          && request.resource.data.ref.size() <= 120
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 8;
        allow delete: if isOwner(roll);
      }
    }

    /* ── Public leaderboard projection ──────────────────────── */

    match /board/{roll} {
      allow read: if signedIn();

      allow create: if signedIn()
        && isOwner(roll)
        && request.resource.data.roll == roll
        && (!request.resource.data.keys().hasAny(['name'])
          || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!request.resource.data.keys().hasAny(['phone'])
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 16))
        && (!request.resource.data.keys().hasAny(['gender'])
          || (request.resource.data.gender is string
            && (request.resource.data.gender == ''
              || request.resource.data.gender in ['male', 'female', 'other', 'prefer-not'])))
        && request.resource.data.dept is string
        && request.resource.data.dept.size() <= 60
        && request.resource.data.year is string
        && request.resource.data.year.size() <= 8
        && request.resource.data.program is string
        && request.resource.data.program.size() <= 8
        && (request.resource.data.groupCode == null
          || (request.resource.data.groupCode is string
            && request.resource.data.groupCode.size() == 6))
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 0
        && request.resource.data.currentStreak <= 25
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak >= 0
        && request.resource.data.longestStreak <= 25
        && request.resource.data.totalDays is int
        && request.resource.data.totalDays >= 0
        && request.resource.data.totalDays <= 25
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 810
        && request.resource.data.updatedAt is number;

      /* The organizer portal toggles early access on a student's projection.
         Board docs hold no private data, and the flag only opens the
         pre-event preview, so a field-only update is allowed for any
         signed-in device (anonymous auth cannot identify the organizer). */
      allow update: if signedIn()
        && (
          (isOwner(roll)
            && request.resource.data.roll == roll
            && (!request.resource.data.keys().hasAny(['name'])
              || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
            && (!request.resource.data.keys().hasAny(['phone'])
              || (request.resource.data.phone is string && request.resource.data.phone.size() <= 16))
            && (!request.resource.data.keys().hasAny(['gender'])
              || (request.resource.data.gender is string
                && (request.resource.data.gender == ''
                  || request.resource.data.gender in ['male', 'female', 'other', 'prefer-not'])))
            && request.resource.data.dept is string
            && request.resource.data.dept.size() <= 60
            && request.resource.data.year is string
            && request.resource.data.year.size() <= 8
            && request.resource.data.program is string
            && request.resource.data.program.size() <= 8
            && (request.resource.data.groupCode == null
              || (request.resource.data.groupCode is string
                && request.resource.data.groupCode.size() == 6))
            && request.resource.data.currentStreak is int
            && request.resource.data.currentStreak >= 0
            && request.resource.data.currentStreak <= 25
            && request.resource.data.longestStreak is int
            && request.resource.data.longestStreak >= 0
            && request.resource.data.longestStreak <= 25
            && request.resource.data.totalDays is int
            && request.resource.data.totalDays >= 0
            && request.resource.data.totalDays <= 25
            && request.resource.data.points is int
            && request.resource.data.points >= 0
            && request.resource.data.points <= 810
            && request.resource.data.updatedAt is number)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earlyAccess'])
            && request.resource.data.earlyAccess is bool)
        );

      allow delete: if false;
    }

    /* ── Groups (max four) ──────────────────────────────────── */

    match /groups/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && alignedMembers(request.resource.data)
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.code == resource.data.code
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is number
        && alignedMembers(request.resource.data)
        && (
          // A member removing themselves. The remaining rolls must still line
          // up with the remaining UIDs, which forces the caller's own roll out.
          (request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && resource.data.memberRolls.hasAll(request.resource.data.memberRolls)
            && !(request.auth.uid in request.resource.data.members))
          // A reader joining: existing members kept, exactly one added, and it
          // is the caller. alignedMembers checks the new roll belongs to them.
          || (request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.memberRolls.hasAll(resource.data.memberRolls)
            && request.resource.data.members.hasAny([request.auth.uid])
            && !(request.auth.uid in resource.data.members))
        );

      allow delete: if signedIn()
        && resource.data.members.size() == 1
        && resource.data.members[0] == request.auth.uid;
    }
  }
}
